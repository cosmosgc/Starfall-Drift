RESOURCE_VARIANT=
# Para músicas da Estação Mega Hetero, use:
# RESOURCE_VARIANT=_MegaHetero

# Overrides opcionais de destino padrão (relativos à raiz do repo ou absolutos).
# Quando vazios, o destino deriva de RESOURCE_VARIANT:
#   áudio   -> Resources/Audio/<variant>/Jukebox
#   catálogo -> Resources/Prototypes/<variant>/Catalog/Jukebox/Standard.yml
# Exemplo de dir privada com .gitignore nos binários:
# JUKEBOX_AUDIO_DIR=Resources/Audio/_MegaHetero/Jukebox
# JUKEBOX_CATALOG_FILE=Resources/Prototypes/_MegaHetero/Catalog/Jukebox/Standard.yml
JUKEBOX_AUDIO_DIR=
JUKEBOX_CATALOG_FILE=
