gun-execution-verb-name =  Executar

gun-execution-verb-message =  Aperte a arma na cabeça deles e puxe o gatilho.

gun-execution-initial-self =  Você pressiona. { THE($weapon) } contra a cabeça de { $victim }.

gun-execution-initial-others = { CAPITALIZE(THE($attacker)) }  Pressiona { POSS-ADJ($attacker) } { $weapon } contra a cabeça de { THE($victim) }.

gun-execution-complete-self =  Você atira. { $victim } Na cabeça.

gun-execution-complete-others = { CAPITALIZE(THE($attacker)) } - Atire. { $victim } Na cabeça.

gun-execution-empty-self = A câmara está vazia.

gun-execution-empty-others = { CAPITALIZE(THE($attacker)) }  puxa o gatilho, mas nada acontece.

gun-execution-suicide-initial-self =  Você pressiona. { THE($weapon) } para o seu templo...

gun-execution-suicide-initial-others = { CAPITALIZE(THE($attacker)) }  Pressiona { POSS-ADJ($attacker) } { $weapon } para o seu próprio templo.

gun-execution-suicide-complete-self =  Você se mata na cabeça!

gun-execution-suicide-complete-others = { $attacker } - Atire. { REFLEXIVE($attacker) } Na cabeça!
