round-end-system-shuttle-called-announcement = Um Transporte de Emergência foi enviado. ETA: { $time } { $units }.

round-end-system-shuttle-already-called-announcement = Um Transporte de Emergência já foi enviado.

round-end-system-shuttle-auto-called-announcement = Um transporte automático de troca de turno da tripulação foi enviado. ETA: { $time } { $units }. Recolha o transporte para estender o turno.

round-end-system-shuttle-recalled-announcement = O Transporte de Emergência foi recolhido.

round-end-system-shuttle-sender-announcement = Estação

round-end-system-round-restart-eta-announcement = Reiniciando a rodada em { $time } { $units }...

eta-units-minutes =
    { $amount ->
        [one] minuto
       *[other] minutos
    }

eta-units-seconds =
    { $amount ->
        [one] segundo
       *[other] segundos
    }
