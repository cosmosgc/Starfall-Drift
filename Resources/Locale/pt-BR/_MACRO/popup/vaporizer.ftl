vaporizer-examine-state =
    { $state ->
       *[normal] [color=lightblue]O vaporizador está funcionando normalmente.[/color]
        [badsolution] [color=red]O vaporizador tem uma solução ruim na câmara![/color]
        [lowsolution] [color=yellow]O vaporizador está com pouco fluido.[/color]
        [empty] [color=red]O vaporizador está vazio.[/color]
    }
