# Shows when attempting to turn the emitter on or off without proper access
comp-emitter-access-locked = O { $target } O acesso está bloqueado!

# Shows when turning the emitter on/off
comp-emitter-turned-on = O { $target }  Liga.

comp-emitter-turned-off = O { $target }  Desliga.

# Shows if the user attempts to activate the emitter while it's un-anchored.
comp-emitter-not-anchored = O { $target }  Não está ancorado no chão!

emitter-component-current-type = O tipo selecionado atual é: [color=yellow]{ $type }[/color].

emitter-component-type-set =  Digite o tipo: { $type }

emitter-destroyed-broadcast = Um emissor de energia. { $location }  Foi destruído.

emitter-deconstructed-broadcast = Um emissor de energia. { $location }  Foi desconstruído.

emitter-unlocked-broadcast = Um emissor de energia. { $location }  foi destrancada.

emitter-unpowered-broadcast = Um emissor de energia. { $location }  perdeu energia.
